# Copy to .env (git-ignored) and fill in. Variables already set in the shell win over this file.
#
# Any OpenAI-compatible chat-completions endpoint works: the base URL is the part before
# /chat/completions.
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=anthropic/claude-sonnet-5.5
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
#   Local:       LLM_BASE_URL=http://localhost:11434/v1      (Ollama, vLLM, LM Studio)

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional. Defaults shown.
# LLM_TIMEOUT_SECONDS=120        one wall for the whole request, retries included
# LLM_MAX_OUTPUT_TOKENS=4000     raise it if a reply is reported as cut off
# LLM_TEMPERATURE=               unset: not sent (some models refuse the parameter)
# LLM_STRUCTURED_OUTPUT=auto     auto | json_schema | json_object | none
#                                auto tries a strict JSON schema, then json_object, then none
